# Set these values in Render's Environment settings. Do not commit backend/.env.
DB_HOST=your-supabase-host
DB_PORT=5432
DB_SSLMODE=require
DB_NAME=postgres
DB_USER=your-database-user
DB_PASS=your-database-password
JWT_SECRET=generate-a-long-random-secret

# Password-reset emails. Use a dedicated Gmail account protected by 2-Step
# Verification. Create an App Password for SmartHOA, then set these only in
# Render's Environment settings. Never commit backend/.env.
GMAIL_SMTP_USER=smarthoa.southwynd@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=smarthoa.southwynd@gmail.com
EMAIL_FROM_NAME=SmartHOA
APP_BASE_URL=https://smart-hoa-sigma.vercel.app

# Optional: only needed after Firebase mobile push is configured.
# Local development: FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# Render: FCM_SERVICE_ACCOUNT_BASE64=<base64-encoded Firebase service-account JSON>

# Web Push for the Vercel PWA / iPhone Home Screen app.
# Keep VAPID_PRIVATE_KEY only in Render. The matching public key goes in Vercel
# as VITE_WEB_PUSH_PUBLIC_KEY.
# VAPID_PUBLIC_KEY=your-url-safe-base64-public-key
# VAPID_PRIVATE_KEY=your-url-safe-base64-private-key
# VAPID_SUBJECT=mailto:your-support-email@example.com
